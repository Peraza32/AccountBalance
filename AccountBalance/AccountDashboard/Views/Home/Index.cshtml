@model ClientSearchViewModel
@{
    ViewData["Title"] = "Buscar cliente";
}

<div class="page-header">
    <h1>Estado de cuenta de tarjeta de crédito</h1>
    <p>Ingrese el número de documento del cliente para consultar sus tarjetas.</p>
</div>

<div class="card" style="max-width: 480px;">
    <h2 class="card-title">Buscar cliente</h2>

    <form asp-controller="Home" asp-action="Index" method="post" novalidate>
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_ModelErrors")

        <div class="form-group">
            <label asp-for="UserId"></label>
            <input asp-for="UserId" class="form-control" placeholder="Ej. 04512345-6" autofocus />
            <span asp-validation-for="UserId" class="field-validation-error"></span>
            <div class="form-hint">Corresponde al DOC_NUMBER registrado en el banco .</div>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>
</div>
