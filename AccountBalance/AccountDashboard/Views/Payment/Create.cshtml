@model PaymentFormViewModel
@{
    ViewData["Title"] = "Registrar pago";
}

<div class="page-header">
    <h1>Registrar pago</h1>
    <p>Tarjeta @Model.CardNumberMasked</p>
</div>

<div class="card" style="max-width: 520px;">
    <h2 class="card-title">Datos del pago</h2>

    <form asp-controller="Payment" asp-action="Create" method="post" data-confirm="¿Confirma registrar este pago?" novalidate>
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_ModelErrors")
        <input type="hidden" asp-for="CardNumberMasked" />

        <div class="form-group">
            <label asp-for="PaymentDate"></label>
            <input asp-for="PaymentDate" class="form-control" type="date" />
            <span asp-validation-for="PaymentDate" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Amount"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
            <span asp-validation-for="Amount" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <input asp-for="Description" class="form-control" placeholder="Ej. Pago desde cuenta de ahorro (opcional)" />
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-primary">Registrar pago</button>
            <a asp-controller="AccountStatement" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
