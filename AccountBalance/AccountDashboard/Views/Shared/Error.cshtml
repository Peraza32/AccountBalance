@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-header">
    <h1>Ocurrió un error</h1>
    <p>@Model.Message</p>
</div>

<div class="card">
    <p>Por favor intente nuevamente. Si el problema persiste, contacte al administrador del sistema.</p>
    @if (Model.ShowRequestId)
    {
        <p class="form-hint">Id. de referencia: <code>@Model.RequestId</code></p>
    }
    <div class="btn-row">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
    </div>
</div>
