<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Estado de Cuenta</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-header__inner">
            <a class="brand" asp-controller="Home" asp-action="Index">Estado de Cuenta · Tarjeta de Crédito</a>
            @if (ViewData["CardId"] is Guid cardId && cardId != Guid.Empty)
            {
                <nav class="app-nav">
                    <a asp-controller="AccountStatement" asp-action="Index" asp-route-cardId="@cardId">Estado de cuenta</a>
                    <a asp-controller="Purchase" asp-action="Create" asp-route-cardId="@cardId">Compras</a>
                    <a asp-controller="Payment" asp-action="Create" asp-route-cardId="@cardId">Pagos</a>
                    <a asp-controller="Transactions" asp-action="Index" asp-route-cardId="@cardId">Historial</a>
                </nav>
            }
        </div>
    </header>

    <main class="app-main">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-error" role="alert">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        Estado de cuenta de tarjeta de crédito &middot; 
    </footer>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
