@model TransactionHistoryViewModel
@{
    ViewData["Title"] = "Historial de transacciones";
    ViewData["CardId"] = Model.CardId;
}

<div class="page-header">
    <h1>Historial de transacciones</h1>
    <span class="subtitle">Compras y pagos del mes, más recientes primero</span>
</div>


<div class="card">
    @if (Model.Transactions.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th class="amount">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    <tr>
                        <td>@tx.Date.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @(tx.Type == "Pago" ? "badge-payment" : "badge-purchase")">@tx.Type</span>
                        </td>
                        <td>@tx.Description</td>
                        <td class="text-muted">@tx.State</td>
                        <td class="amount money">@tx.Amount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">No hay transacciones registradas este mes.</div>
    }
</div>

<div class="btn-row">
    <a class="btn btn-secondary" asp-controller="AccountStatement" asp-action="Index" asp-route-cardId="@Model.CardId">Volver al estado de cuenta</a>
</div>
